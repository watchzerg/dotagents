#!/usr/bin/env bash
#MISE description="{{LABEL}}：在主机锁内运行 tests/full；可传 pytest 参数定向"
# tests/full 下出现 pytest 测试文件（test_*.py、*_test.py）即纳入，此时零收集视为失败；目录不存在或只有
# 其他 stack 的文件时打印提示并通过。默认范围用 -o testpaths=tests/full 指定，所以 -k 等参数在 tests/full
# 内筛选，给出路径时只运行该路径。有测试时本脚本经 scripts/with_lock.py 重新执行自身，持锁运行。
set -euo pipefail
cd "$MISE_CONFIG_ROOT/{{HOME_DIR}}"
if [ ! -d tests/full ] || [ -z "$(find tests/full -type f \( -name 'test_*.py' -o -name '*_test.py' \) -print -quit)" ]; then
  echo '提示：{{HOME}}tests/full 下没有 pytest 测试文件，{{LABEL}} 尚无 full 测试。'
  exit 0
fi
if [ -z "${GATE_LOCK_HELD:-}" ]; then
  export GATE_LOCK_HELD=1
  exec python3 "$MISE_CONFIG_ROOT/scripts/with_lock.py" "$0" "$@"
fi
if [ "$#" -eq 0 ]; then unset PYTEST_ADDOPTS; fi
exec uv run --locked python -m pytest -o testpaths=tests/full "$@"
